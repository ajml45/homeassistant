# Ignore everything by default; whitelist what we intentionally version.
*

# Repo housekeeping
!.gitignore
!README.md
!git-backup.sh

# Core config (root-level includes referenced from configuration.yaml)
!configuration.yaml
!automations.yaml
!scripts.yaml
!scenes.yaml
!groups.yaml
!input_booleans.yaml
!input_select.yaml
!sensors.yaml
!templates.yaml

# Themes (loaded via !include_dir_merge_named themes)
!themes/
themes/*
!themes/*.yaml

# Dashboards (source of truth for the UI dashboards; paste into raw editor / yaml mode)
!frontends/
frontends/*
!frontends/*.yaml

# Never commit these even if a rule above would match
.ssh/
git-backup.log
secrets.yaml
.storage/
*.log
*.db
*.db-*
